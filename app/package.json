{
	"name": "app",
	"version": "0.0.1",
	"description": "This is nestjs application deploye in aws sam app",
	"main": "app.js",
	"repository": "https://github.com/gnest-org/tree/express",
	"author": "Daris",
	"private": true,
	"license": "MIT",
	"scripts": {
		"build": "node esbuild.config.js",
		"unit": "jest",
		"lint": "eslint '*.ts' --quiet --fix",
		"compile": "tsc",
		"test": "npm run compile && npm run unit",
		"dev": "nodemon app.local.ts",
		"typeorm": "pnpx tsx ./node_modules/typeorm/cli.js -d ./src/config/data-source.ts",
		"typeorm:generate": "pnpm typeorm migration:generate ./src/database/migrations/migration --timestamp",
    "typeorm:create": "pnpm typeorm migration:create ./src/database/migrations/migration ",
    "typeorm:run": "pnpm typeorm migration:run",
    "typeorm:revert": "pnpm typeorm migration:revert"
	},
	"resolutions": {
		"path-scurry": "1.3.0",
		"glob": "9.3.5"
	},
	"dependencies": {
		"@types/cookie-parser": "^1.4.10",
		"@types/express-session": "^1.19.0",
		"@types/express-validator": "^3.0.2",
		"@vendia/serverless-express": "^4.12.6",
		"aws-lambda": "^1.0.7",
		"bcryptjs": "^3.0.3",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "^17.4.2",
    	"esbuild": "^0.28.2",
		"express": "^5.2.1",
		"express-session": "^1.19.0",
		"express-validator": "^7.3.2",
		"glob": "13.0.6",
		"joi": "^18.2.8",
		"jsonwebtoken": "^9.0.3",
		"nodemon": "^3.1.14",
		"path-scurry": "2.0.2",
		"pg": "^8.23.0",
		"reflect-metadata": "^0.2.2",
		"typeorm": "^1.1.1"
	},
	"devDependencies": {
    	"@jest/globals": "^30.5.1",
		"@types/aws-lambda": "^8.10.163",
		"@types/bcryptjs": "^3.0.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/node": "^26.4.1",
		"@types/pg": "^8.23.1",
		"@types/reflect-metadata": "^0.1.0",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.69.0",
		"@typescript-eslint/parser": "^8.69.0",
		"eslint": "^10.10.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.6",
		"jest": "^30.5.1",
		"prettier": "^3.9.6",
		"nodemon": "^3.1.14",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.12",
		"ts-node": "^10.9.2",
		"typeorm-ts-node-commonjs": "^0.3.20",
		"typescript": "^7.0.2"
	}
}
